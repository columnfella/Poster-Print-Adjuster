  }
  p.x = e.clientX; p.y = e.clientY; cur.v++; zsync(); live();
};
cv.onpointerup = cv.onpointercancel = e => { P.delete(e.pointerId); deb(); };
cv.addEventListener("wheel", e => {
  if (!cur) return; e.preventDefault(); const r = cv.getBoundingClientRect();
  setF(cur.z.f * Math.exp(-e.deltaY * .0015), (e.clientX - r.left) / r.width, (e.clientY - r.top) / r.height); cur.v++; zsync(); live(); deb();
}, {passive: false});
$("zm").oninput = () => { if (!cur) return; setF(base(cur) * $("zm").value); cur.v++; live(); deb(); };
document.querySelectorAll("[data-fit]").forEach(b => b.onclick = () => { if (!cur) return; fit(cur, b.dataset.fit); cur.v++; zsync(); live(); lists(); });
$("size").onchange = () => { const o = F(); o.size = $("size").value; if (cur) cur.v++; refresh(); };
$("orient").querySelectorAll("button").forEach(b => b.onclick = () => {
  const o = F(); if (o.orient === b.dataset.o) return; o.orient = b.dataset.o;
  if (cur){ fit(cur, "bleed"); cur.v++; } refresh();
});
$("save").onclick = () => {
  if (!cur) return; const was = cur.done; cur.done = true; cur.v++;
  const nx = items.find(i => !i.done); toast(was ? "Changes saved." : nx ? "Saved. Next image loaded." : "Saved. Every image is adjusted.");
  pick(nx || cur);
};
function listClick(e){
  const el = e.target.closest("[data-id]"); if (!el) return; const it = items.find(i => i.id == el.dataset.id); if (!it) return;
  if (e.target.closest(".rm")){ items.splice(items.indexOf(it), 1); if (cur === it) pick(items.find(i => !i.done) || items[0]); else lists(); }
  else if (e.target.closest(".dl")) dlOne(it);
  else pick(it);
}
$("qa").onclick = $("qr").onclick = listClick;

// ---------- upload zone ----------
const drop = $("drop"), file = $("file");
drop.onclick = () => file.click();
drop.onkeydown = e => { if (e.key === "Enter" || e.key === " "){ e.preventDefault(); file.click(); } };
["dragenter","dragover"].forEach(ev => drop.addEventListener(ev, e => { e.preventDefault(); drop.classList.add("over"); }));
["dragleave","drop"].forEach(ev => drop.addEventListener(ev, e => { e.preventDefault(); drop.classList.remove("over"); }));
drop.addEventListener("drop", e => addFiles(e.dataTransfer.files));
file.onchange = () => { addFiles(file.files); file.value = ""; };
window.addEventListener("dragover", e => e.preventDefault());
window.addEventListener("drop", e => e.preventDefault());
window.addEventListener("resize", () => { layout(); draw(); });
refresh();
</script>
